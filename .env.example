# Copy this file to .env before starting.
# Default: lightweight model with explicit tool-calling support.
LLM_MODEL=ai/qwen2.5:3B-Q4_K_M

# To retry PrismML Bonsai instead, use:
# LLM_MODEL=hf.co/prism-ml/Bonsai-8B-gguf:Q1_0

SPRING_APP_PORT=8080
OPEN_WEBUI_PORT=3000

# Relative to compose.yaml, or use an absolute host path.
# Mount only a safe test directory; it is exposed read-only to the MCP server.
FILES_HOST_DIR=./sample-files

# Only used by the optional Open WebUI profile.
WEBUI_SECRET_KEY=replace-with-a-long-random-local-secret

APP_WORKSPACE_DEFAULT_MAX_RESULTS=100
APP_WORKSPACE_MAX_RESULTS_LIMIT=500
APP_WORKSPACE_DEFAULT_MAX_CHARACTERS=12000
APP_WORKSPACE_MAX_CHARACTERS_LIMIT=50000
APP_WORKSPACE_MAX_READABLE_FILE_BYTES=2000000
